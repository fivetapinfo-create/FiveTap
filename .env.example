# FiveTap — copia a .env.local para desarrollo. En Vercel: Settings → Environment Variables.

# ── Obligatorias ─────────────────────────────────────────────
# Dominio final. Cada placa NFC y cada QR se graban con él: defínelo ANTES de grabar.
NEXT_PUBLIC_SITE_URL=https://fivetap.app
# Supabase → Project Settings → API. La service_role es secreta (solo servidor).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Contraseña del panel /admin (usuario por defecto: admin).
ADMIN_USER=admin
ADMIN_PASSWORD=
# Tu WhatsApp de ventas (solo dígitos, con 507). Botones "Prueba gratis" de la landing.
NEXT_PUBLIC_SALES_WHATSAPP=5076000000

# ── Email (opcional, gratis hasta 3.000/mes con Resend) ──────
# Sin esto, los mensajes privados igual llegan al panel (/admin/mensajes).
RESEND_API_KEY=
# Debe ser de un dominio verificado en Resend. Para probar sin dominio:
# "FiveTap <onboarding@resend.dev>" (solo entrega al email de tu cuenta Resend).
EMAIL_FROM=FiveTap <alertas@fivetap.app>
# Copia de cada mensaje privado para ti.
FOUNDER_EMAIL=

# ── Pagos (opcional; /pagar muestra solo lo que esté definido) ──
# PayPal acepta Visa, Mastercard y Amex sin cuenta PayPal.
# Suscripciones (cobro automático) y enlaces de pago único.
# Plan mensual $129 con 7 días gratis (suscripción). También alimenta el botón de /prueba.
PAYPAL_MONTHLY_TRIAL_URL=
# Plan anual $1,290 y su mitad $645 (enlaces de pago único).
PAYPAL_ANNUAL_URL=
PAYPAL_ANNUAL_HALF_URL=
# 1 placa $35/mes (suscripción), 2 placas $60 y tarjeta de mesero $25 (pago único).
PAYPAL_PLAQUE_URL=
PAYPAL_PACK_URL=
PAYPAL_WAITER_URL=
# Client ID de PayPal (público): muestra el botón de pago dentro de /prueba.
PAYPAL_CLIENT_ID=
# Enlace de una pasarela local de tarjetas, cuando la tengas.
CARD_PAYMENT_URL=
YAPPY_HANDLE=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_TYPE=
BANK_ACCOUNT_NUMBER=
